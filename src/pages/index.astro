---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import portrait from "../assets/julia-kaplan.jpg";
---

<BaseLayout title={site.name}>
  <section class="hero">
    <div class="portrait fade-up">
      <Image
        src={portrait}
        alt={site.name}
        width={520}
        height={650}
        loading="eager"
      />
    </div>
    <div class="intro">
      <p class="fade-up" style="--delay: 0.1s">
        I am an integrative psychodynamic therapist in New York City.
      </p>
      <p class="fade-up" style="--delay: 0.2s">
        I work with adults who may be experiencing anxiety, depression,
        relationship challenges, and other concerns.
      </p>
      <p class="fade-up" style="--delay: 0.3s">
        <a href="/about/" class="cta" data-label="Learn more"
          ><span>Learn more</span></a
        > or <a href="/contact/" class="cta" data-label="get in touch"
          ><span>get in touch</span></a
        >.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-md);
    align-items: center;
  }

  .fade-up {
    animation: fade-up 1s both cubic-bezier(0.22, 1, 0.36, 1);
    animation-delay: var(--delay, 0s);
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--space-lg);
    }
  }

  .portrait {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 10px;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .intro {
    position: relative;
    top: -10px;
  }

  .intro > * + * {
    margin-top: var(--space-sm);
  }

  .intro p {
    font-size: 32px;
    line-height: 1.33;
    font-weight: 200;
    font-family: var(--font-serif);
  }

  @media (max-width: 600px) {
    .intro p {
      font-size: 24px;
    }
  }

  .tagline {
    font-size: var(--step-1);
    color: var(--color-muted);
  }

  .cta {
    display: inline-grid;
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    font-family: var(--font-serif);
  }

  .cta span,
  .cta::before,
  .cta::after {
    grid-area: 1 / 1;
  }

  .cta::before,
  .cta::after {
    content: attr(data-label);
    visibility: hidden;
  }

  .cta::before {
    font-style: normal;
  }

  .cta::after {
    font-style: italic;
  }

  .cta:hover span {
    font-style: italic;
  }
</style>
